# ─── TELEGRAM ──────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
TOKEN=YOUR_BOT_TOKEN_HERE
# Your Telegram user ID (get from @userinfobot)
ADMIN=YOUR_TELEGRAM_ID
# Public URL for webhook mode (leave empty for polling/DEBUG mode)
URL=
# True = polling mode (local dev), False = webhook (production)
DEBUG=True

# ─── SESSION ───────────────────────────────────────────────
# Format: "drop_duration check_duration round_duration" (in minutes)
SESSION_DURATION=5 10 30

# ─── WHOP ──────────────────────────────────────────────────
# Get from Whop Developer Dashboard
WHOP_API_KEY=your_whop_api_key_here
WHOP_COMPANY_ID=your_whop_company_id_here

# ─── STAFF CHANNELS ────────────────────────────────────────
# Telegram group chat IDs for team/creator notifications (optional)
STAFF_CHAT_ID=
CREATOR_CHAT_ID=

# ─── OPENAI ───────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys (optional)
OPENAI_API_KEY=

# ─── GMAIL (for email outreach script) ──────────────────
# Gmail SMTP app password (enable 2FA, then create app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
